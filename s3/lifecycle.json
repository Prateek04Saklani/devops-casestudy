{                                           
    "Rules": [                                          
      {                                                                                                                            
        "ID": "csv-processed-lifecycle",                            
        "Status": "Enabled",                                                                                                       
        "Filter": {                                                                                                                
          "Prefix": "processed/"                                                                                                   
        },                               
        "Transitions": [
          {
            "Days": 30,
            "StorageClass": "STANDARD_IA"
          },
          {
            "Days": 90,
            "StorageClass": "GLACIER"
          }
        ],
        "Expiration": {
          "Days": 365
        }
      }
    ]
  }